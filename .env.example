# Self-hosted production configuration. Keep real values in /etc/kimia/kimia.env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3018
PUBLIC_BASE_URL=https://kbkimiabeauty.ir
DATABASE_URL=postgresql://kimia_app@127.0.0.1:5432/kimia
DATABASE_PASSWORD=
UPLOAD_DIR=/var/lib/kimia/uploads
# Optional. Defaults to the apex domain, www domain, localhost and 127.0.0.1.
ALLOWED_HOSTS=kbkimiabeauty.ir,www.kbkimiabeauty.ir,localhost,127.0.0.1

# Legacy Sites settings only; not used by the self-hosted server.
ADMIN_EMAILS=
ADMIN_USER_IDS=
RATE_LIMIT_SALT=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Customer authentication intentionally remains disabled; do not set these.
AUTH_CUSTOMER_ENABLED=
AUTH_SMS_URL=
AUTH_SMS_TOKEN=
AUTH_SMS_FROM=
